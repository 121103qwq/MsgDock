<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_00">
<ScrollView
    android:id="@+id/main_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_00"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MsgDock"
            style="@style/Text.Display"
            android:layout_marginBottom="@dimen/spacing_xs"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="局域网与云端短信同步"
            style="@style/Text.Body"
            android:textColor="@color/accent_primary"
            android:layout_marginBottom="@dimen/spacing_xl"/>

        <Button
            android:id="@+id/btn_account_inbox"
            style="@style/Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="本机收件箱 · 短信历史"
            android:layout_marginBottom="@dimen/spacing_md"/>

        <Button
            android:id="@+id/btn_background_guide"
            style="@style/Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="后台运行教程 · 电池 / 小锁 / 自启动"
            android:layout_marginBottom="@dimen/spacing_md"/>

        <!-- Account Sync Section -->
        <LinearLayout
            android:id="@+id/card_account"
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="账号同步"
                style="@style/Text.Title.Large"
                android:layout_marginBottom="@dimen/spacing_sm"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="登录同一账号，可上传本机短信，也可接收其他手机同步的短信。接收不需要扫码配对或短信权限。"
                style="@style/Text.Caption"
                android:layout_marginBottom="@dimen/spacing_md"/>

            <CheckBox
                android:id="@+id/check_account_receive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="接收账号短信（无需配对）"
                android:textColor="@color/accent_primary"/>

            <Button
                android:id="@+id/btn_account_refresh"
                style="@style/Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="立即收取账号短信"
                android:layout_marginBottom="@dimen/spacing_sm"/>

            <EditText
                android:id="@+id/edit_account_username"
                style="@style/EditText.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="用户名（登录时也可填邮箱）"
                android:inputType="text"
                android:layout_marginBottom="@dimen/spacing_sm"/>

            <EditText
                android:id="@+id/edit_account_email"
                style="@style/EditText.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="邮箱（注册时填写）"
                android:inputType="textEmailAddress"
                android:layout_marginBottom="@dimen/spacing_sm"/>

            <EditText
                android:id="@+id/edit_account_password"
                style="@style/EditText.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="密码"
                android:inputType="textPassword"
                android:layout_marginBottom="@dimen/spacing_md"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/spacing_sm">

                <Button
                    android:id="@+id/btn_account_login"
                    style="@style/Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="登录"
                    android:layout_marginEnd="@dimen/spacing_sm"/>

                <Button
                    android:id="@+id/btn_account_register"
                    style="@style/Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="注册"/>
            </LinearLayout>

            <Button
                android:id="@+id/btn_account_logout"
                style="@style/Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="退出账号"
                android:layout_marginBottom="@dimen/spacing_md"/>

            <TextView
                android:id="@+id/text_account_status"
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="账号：未登录"/>
        </LinearLayout>

        <!-- Cloud Relay Section -->
        <LinearLayout
            android:id="@+id/card_cloud_relay"
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="① 云端转发"
                style="@style/Text.Title.Large"
                android:layout_marginBottom="@dimen/spacing_sm"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="端到端加密 · P-256 ECDH + AES-256-GCM"
                style="@style/Text.Caption"
                android:textColor="@color/accent_success"
                android:layout_marginBottom="@dimen/spacing_md"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="主 Relay（优先，固定地址）"
                style="@style/Text.Body"
                android:layout_marginBottom="@dimen/spacing_xs"/>

            <TextView
                android:id="@+id/edit_relay_url"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textIsSelectable="true"
                android:layout_marginBottom="@dimen/spacing_md"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Text.Body"
                android:text="备用 Relay（连接失败时使用，固定地址）"/>

            <TextView
                android:id="@+id/text_backup_relay_url"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textIsSelectable="true"
                android:layout_marginBottom="@dimen/spacing_md"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_md">

                <Button
                    android:id="@+id/btn_cloud_pair_sender"
                    style="@style/Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="发送配对"/>
            </LinearLayout>

            <Button
                android:id="@+id/btn_cloud_pair_receiver"
                style="@style/Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="生成接收配对码"
                android:layout_marginBottom="@dimen/spacing_md"/>

            <TextView
                android:id="@+id/text_cloud_status"
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="云状态：未配置"/>
        </LinearLayout>

        <!-- Device Management Section -->
        <LinearLayout
            android:id="@+id/card_device_management"
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="② 设备管理"
                style="@style/Text.Title.Large"
                android:layout_marginBottom="@dimen/spacing_sm"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="机器码用于自动恢复云链路，不是密码"
                style="@style/Text.Body"
                android:layout_marginBottom="@dimen/spacing_md"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/spacing_md"
                android:background="@drawable/input_field"
                android:layout_marginBottom="@dimen/spacing_md">

                <TextView
                    android:id="@+id/text_machine_code"
                    style="@style/Text.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="计算中..."
                    android:textColor="@color/accent_primary"
                    android:fontFamily="monospace"/>

                <Button
                    android:id="@+id/btn_copy_machine_code"
                    style="@style/Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="复制"
                    android:minHeight="36dp"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md"/>
            </LinearLayout>

            <TextView
                android:id="@+id/text_backup_status"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="备份状态：检查中"
                android:layout_marginBottom="@dimen/spacing_md"/>

            <LinearLayout
                android:id="@+id/container_cloud_links"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/spacing_md"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_sync_recover"
                    style="@style/Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="同步 / 恢复"
                    android:layout_marginEnd="@dimen/spacing_sm"/>

                <Button
                    android:id="@+id/btn_delete_device"
                    style="@style/Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="删除云记录"
                    android:textColor="@color/accent_error"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Sender Section -->
        <LinearLayout
            android:id="@+id/card_sender"
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="③ 手机发送端"
                style="@style/Text.Title.Large"
                android:layout_marginBottom="@dimen/spacing_md"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_sm">

                <TextView
                    android:id="@+id/text_sms_permission"
                    style="@style/Text.Body.Large"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="短信权限：未允许"/>

                <Button
                    android:id="@+id/btn_request_sms"
                    style="@style/Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="申请"
                    android:minHeight="36dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_nearby_permission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_md">

                <TextView
                    android:id="@+id/text_nearby_permission"
                    style="@style/Text.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="附近设备：未允许"/>

                <Button
                    android:id="@+id/btn_request_nearby"
                    style="@style/Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="申请"
                    android:minHeight="36dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/spacing_md">

                <Button
                    android:id="@+id/btn_scan_lan"
                    style="@style/Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="扫描 LAN"
                    android:layout_marginEnd="@dimen/spacing_sm"/>

                <Button
                    android:id="@+id/btn_manual_add"
                    style="@style/Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="手动添加"/>
            </LinearLayout>

            <Button
                android:id="@+id/btn_send_test"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="发送测试消息"
                android:layout_marginBottom="@dimen/spacing_md"/>

            <LinearLayout
                android:id="@+id/container_targets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </LinearLayout>

        <!-- Receiver Section -->
        <LinearLayout
            android:id="@+id/card_receiver"
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="④ Pad 接收端"
                style="@style/Text.Title.Large"
                android:layout_marginBottom="@dimen/spacing_md"/>

            <TextView
                android:id="@+id/text_receiver_status"
                style="@style/Text.Body.Large"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="接收服务：未启动"
                android:layout_marginBottom="@dimen/spacing_md"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_start_receiver"
                    style="@style/Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="启动接收"
                    android:layout_marginEnd="@dimen/spacing_sm"/>

                <Button
                    android:id="@+id/btn_stop_receiver"
                    style="@style/Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="停止接收"/>
            </LinearLayout>
        </LinearLayout>

        <!-- System Settings Section -->
        <LinearLayout
            android:id="@+id/card_system"
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⑤ 系统设置"
                style="@style/Text.Title.Large"
                android:layout_marginBottom="@dimen/spacing_md"/>

            <Button
                android:id="@+id/btn_battery_optimize"
                style="@style/Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="关闭电池优化限制"
                android:layout_marginBottom="@dimen/spacing_sm"/>

            <Button
                android:id="@+id/btn_app_settings"
                style="@style/Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="打开应用设置"
                android:layout_marginBottom="@dimen/spacing_sm"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/spacing_md">

                <Button
                    android:id="@+id/btn_open_shizuku"
                    style="@style/Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="打开 Shizuku"
                    android:layout_marginEnd="@dimen/spacing_sm"/>

                <Button
                    android:id="@+id/btn_copy_adb"
                    style="@style/Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="复制 ADB 命令"/>
            </LinearLayout>

            <TextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="小米 / HyperOS 建议开启：自启动、后台无限制\n若验证码不触发，关闭'免费网络短信'"/>
        </LinearLayout>

        <!-- Security Notice -->
        <TextView
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="安全说明：LAN 使用 TCP 58123 + X-Xgy-Key；云端端到端加密，Relay 无法读取明文"
            android:textColor="@color/text_tertiary"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_xl"/>
    </LinearLayout>
</ScrollView>
</FrameLayout>
