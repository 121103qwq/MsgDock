{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "xgy-sms-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-23",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://msgdock.dpdns.org"
  },
  "assets": {
    "directory": "../web-ui",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/v1/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "msgdock",
      "database_id": "e9538d9c-f98a-40ae-b948-af7acdb56050",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    {
      "pattern": "msgdock.dpdns.org",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY",
        "class_name": "Relay"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Relay"]
    }
  ]
}
